; Animals Farm — 동물의 숲 모티브 웹 게임 (Godot 4, GDScript)
; 웹 배포가 목표이므로 렌더러는 GL Compatibility(WebGL2)로 고정하고,
; 웹 export는 nothreads 프리셋을 쓴다(SharedArrayBuffer 요구를 피해
; COOP/COEP 헤더 없이도 열리게 — 자세한 근거는 docs/deploy.md 참조).

config_version=5

[application]

config/name="Animals Farm"
config/description="동물의 숲 모티브 웹 게임"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Regular.otf"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
