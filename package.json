{
  "name": "animals_farm",
  "version": "0.1.0",
  "type": "module",
  "description": "게임 프로젝트 — trading 프로젝트의 개발 프로세스(모델별 페르소나 + 텔레그램 푸쉬) 이식",
  "private": true,
  "scripts": {
    "notify": "node scripts/telegram-ask.js --notify",
    "ask": "node scripts/telegram-ask.js",
    "review:code": "node scripts/review.js --last",
    "review:docs": "node scripts/review.js --docs",
    "review:write": "zsh -l -c \"codex exec --sandbox workspace-write '요구사항과 구현 코드의 불일치 분석 및 자동 문서 갱신' < /dev/null\"",
    "postinstall": "node scripts/install-git-hooks.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "panel": "node scripts/cli-runner.js",
    "review:staged": "node scripts/review.js --staged",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:server": "node --test tests/server-world.test.mjs",
    "test": "npm run test:server",
    "test:multiplayer": "node tests/browser-multiplayer.mjs",
    "capture:chat": "node tests/capture-chat-ui.mjs",
    "test:mobile": "node tests/browser-mobile.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
