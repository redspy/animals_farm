#!/bin/zsh
# 커밋 전 헤드리스 Claude/Codex 교차 리뷰 게이트.
# 이 파일이 원본이며 `npm install`(postinstall) 또는 `npm run hooks:install`이
# .git/hooks/pre-commit으로 복사한다. .git/hooks/는 git 추적 대상이 아니므로
# 반드시 이 경로에서 관리할 것.

# zsh는 `:(exclude)*.lock` 같은 git pathspec을 glob으로 해석해 매칭 실패 시
# "no matches found"로 죽는다(2026-09-03 이식 첫 커밋에서 실측 — 그 결과
# git diff가 실패해 Claude에게 빈 stdin이 넘어갔다). 이 훅 안에서만 끈다.
setopt no_nomatch

# lock/자동생성 파일은 diff가 커서 리뷰 시간만 늘어나므로 제외.
# 인용부호를 문자열에 포함시켜 `zsh -l -c` 안에서도 glob 해석되지 않게 한다.
DIFF_EXCLUDES="-- . ':(exclude)*.lock' ':(exclude)package-lock.json' ':(exclude)*.min.js'"

echo "=========================================================="
echo "🔍 [Git Pre-commit] Headless Claude Code CLI Review..."
echo "=========================================================="

# 게임 데이터/밸런스가 JSON·YAML로 분리되면 코드 확장자가 하나도 없는 커밋이
# 생기는데, 밸런스 테이블이야말로 리뷰 대상이므로 데이터 확장자도 포함한다.
git diff --cached --name-only -- . ':(exclude)*.lock' ':(exclude)package-lock.json' ':(exclude)*.min.js' \
  | grep -q -E '\.(js|jsx|ts|tsx|py|cs|gd|ya?ml|json|sh)$'
HAS_CODE=$?

# 인증/쿼터 문제(fail-open 정책, AGENTS.md §4)뿐 아니라 일시적 서버 오류
# (API Error: 5xx)도 건너뛴다 — 자율개발 세션이 프로바이더 장애 하나로
# 통째로 멈추는 것을 막기 위함(2026-09-03 첫 커밋에서 500으로 실제 차단됨).
SKIP_PATTERN="Not logged in|Please run /login|Authentication|session limit|usage limit|rate limit|limit reached|quota|API Error: 5[0-9][0-9]|Internal server error|Overloaded"

if [ $HAS_CODE -eq 0 ]; then
  CLAUDE_OUTPUT=$(zsh -l -c "git diff --cached ${DIFF_EXCLUDES} | claude -p '게임 로직 정확성, 상태 동기화/세이브 데이터 정합성, 밸런스 데이터 유효범위, 성능(프레임/GC/할당), 시크릿 하드코딩 여부 리뷰' --allowedTools 'Read'" 2>&1)
  CLAUDE_STATUS=$?
  echo "$CLAUDE_OUTPUT"
  if [ $CLAUDE_STATUS -ne 0 ]; then
    if echo "$CLAUDE_OUTPUT" | grep -q -E "$SKIP_PATTERN"; then
      echo "⚠️ [Git Pre-commit] Claude CLI 미인증/쿼터/일시장애 — 코드 리뷰 건너뜀(fail-open)."
    else
      echo "❌ [Git Pre-commit] Claude CLI Review 실패. 커밋 중단."
      exit $CLAUDE_STATUS
    fi
  fi
else
  echo "ℹ️ 코드/데이터 변경 없음 — Claude 리뷰 건너뜀."
fi

echo "=========================================================="
echo "🔍 [Git Pre-commit] Headless Codex Document Sync Check..."
echo "=========================================================="

# stdin을 </dev/null로 리다이렉트하지 않으면 "Reading additional input from
# stdin..."에서 무한 대기할 수 있음(trading/connect_dise에서 실측)
CODEX_OUTPUT=$(zsh -l -c "codex exec '설계 문서(AGENTS.md, docs/design.md)와 소스 코드 간 정합성 감사' < /dev/null" 2>&1)
CODEX_STATUS=$?
echo "$CODEX_OUTPUT"
if [ $CODEX_STATUS -ne 0 ]; then
  if echo "$CODEX_OUTPUT" | grep -q -E "$SKIP_PATTERN"; then
    echo "⚠️ [Git Pre-commit] Codex CLI 미인증/쿼터/일시장애 — 문서 정합성 검사 건너뜀(fail-open)."
  else
    echo "❌ [Git Pre-commit] Codex Document Sync Check 실패. 커밋 중단."
    exit $CODEX_STATUS
  fi
fi

echo "=========================================================="
echo "✅ [Git Pre-commit] 감사 완료. 커밋 진행."
echo "=========================================================="
exit 0
