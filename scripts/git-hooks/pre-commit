#!/bin/zsh
# 커밋 전 헤드리스 Claude/Codex 교차 리뷰 게이트.
# 이 파일이 원본이며 `npm install`(postinstall) 또는 `npm run hooks:install`이
# .git/hooks/pre-commit으로 복사한다. .git/hooks/는 git 추적 대상이 아니므로
# 반드시 이 경로에서 관리할 것.
#
# 프롬프트/CLI 호출/fail-open 판정은 전부 scripts/review.js가 소유한다 —
# 예전엔 이 훅이 프롬프트를 자체 복사해 갖고 있었고 `--session-id`가 빠져
# 자기검증 편향 방지 규칙(docs/agents/roles.md §0)이 실제로는 깨져 있었다.
# 이 훅에서 직접 `claude -p`를 호출하지 말 것.

cd "$(git rev-parse --show-toplevel)" || exit 1

node scripts/review.js --staged || exit 1
node scripts/review.js --docs || exit 1

echo "=========================================================="
echo "✅ [Git Pre-commit] 감사 완료. 커밋 진행."
echo "=========================================================="
exit 0
