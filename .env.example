# scripts/telegram-ask.js 전용 — trading/connect_dise와 동일한 봇을 재사용한다
# (봇 하나로 여러 프로젝트 알림을 받고, 메시지 접두어 [animals_farm]로 구분).
# CHAT_ID를 모르면 `node scripts/telegram-ask.js --get-chat-id`로 확인.
TELEGRAM_ASK_BOT_TOKEN=
TELEGRAM_ASK_CHAT_ID=

# 헤드리스 CLI 3종 경로 (scripts/cli-runner.js가 사용, 비우면 기본 경로 사용)
CLAUDE_CLI_PATH=/Users/soul/.local/bin/claude
CODEX_CLI_PATH=/usr/local/bin/codex
GEMINI_CLI_PATH=/Users/soul/.local/bin/agy
